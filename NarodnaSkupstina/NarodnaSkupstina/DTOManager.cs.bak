                        p.IzbornaLista, p.DatumRodj, p.Mesto, p.Ulica, p.Broj, p.Mesto, p.BrTel, p.BrMobTel, p.StalniRadniOdnosFlag));
                }

                s.Close();
            }
            catch (Exception ec)
            {
                MessageBox.Show(ec.Message);
            }

            return zahtevi;
        }

